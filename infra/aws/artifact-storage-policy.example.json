{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CheckPrivateVersionedBucket",
      "Effect": "Allow",
      "Action": ["s3:GetBucketPublicAccessBlock", "s3:GetBucketVersioning"],
      "Resource": "arn:aws:s3:::<bucket-name>",
      "Condition": {"Bool": {"aws:SecureTransport": "true"}}
    },
    {
      "Sid": "ReadOnlyDeploymentObjects",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::<bucket-name>/<deployment-prefix>/*",
      "Condition": {"Bool": {"aws:SecureTransport": "true"}}
    },
    {
      "Sid": "ConditionalEncryptedPublication",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::<bucket-name>/<deployment-prefix>/*",
      "Condition": {
        "Bool": {"aws:SecureTransport": "true"},
        "StringEquals": {"s3:x-amz-server-side-encryption": "AES256", "s3:if-none-match": "*"}
      }
    },
    {
      "Sid": "NoRuntimeDeletion",
      "Effect": "Deny",
      "Action": ["s3:DeleteObject", "s3:DeleteObjectVersion"],
      "Resource": "arn:aws:s3:::<bucket-name>/<deployment-prefix>/*"
    }
  ]
}
