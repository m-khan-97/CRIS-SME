{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CRIS-SME capability evidence register",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reviewed_on",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "reviewed_on": {
      "type": "string",
      "format": "date"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/capability"
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9_. /()-]+$"
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "observed_on",
        "scope",
        "environment",
        "observer",
        "independence"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "observed_on": {
          "type": "string",
          "format": "date"
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "environment": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "observer": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "independence": {
          "enum": [
            "internal",
            "independent"
          ]
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "owner",
        "delivery",
        "scope",
        "implementation",
        "fixture_tests",
        "live_observations",
        "independent_reviews",
        "limitations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "delivery": {
          "enum": [
            "implemented",
            "planned"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "implementation": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "fixture_tests": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "live_observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record"
          }
        },
        "independent_reviews": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record"
          }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "delivery": {
                "const": "implemented"
              }
            }
          },
          "then": {
            "properties": {
              "implementation": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "implementation": {
                "maxItems": 0
              },
              "fixture_tests": {
                "maxItems": 0
              },
              "live_observations": {
                "maxItems": 0
              },
              "independent_reviews": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}
